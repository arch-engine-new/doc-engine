DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/docengine
QDRANT_URL=http://127.0.0.1:6333
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
# Live health requires MINIO_ENDPOINT; missing or ensureBucket failure → HTTP 503 BLOCKED (not skip).
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=docengine
# Live OCR uses PaddleOCR AI Studio; leave empty for fixture-only / FakeOcr.
PADDLEOCR_ACCESS_TOKEN=
# Optional; defaults shown. Do not put a real token in this file.
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
PADDLEOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_POLL_TIMEOUT_MS=180000
# Live independent HTTP rerank (HttpReranker). Leave empty for defaults.
# RERANK_URL — optional full POST URL override (default DashScope compatible-api /reranks).
# RERANK_MODEL — optional ranker model id (default qwen3-rerank).
# RERANK_API_KEY — optional dedicated rerank key; if unset, falls back to DASHSCOPE_API_KEY.
RERANK_URL=
RERANK_MODEL=
RERANK_API_KEY=
