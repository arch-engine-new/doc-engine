    {
      "id": "getExtraction",
      "method": "GET",
      "path": "/api/jobs/:id/extraction",
      "status": "wired",
      "pages": ["check_findings"],
      "note": "Wired from check_findings extraction JSON panel"
    },
    {
      "id": "previewVolume",
      "method": "POST",
      "path": "/api/jobs/:id/volume",
      "status": "wired",
      "pages": ["volume_preview"],
      "note": "Wired from volume_preview; tree.submitted forced false; submit disabled"
    },
    {
      "id": "getVolumePreview",
      "method": "GET",
      "path": "/api/jobs/:id/volume",
      "status": "wired",
      "pages": ["volume_preview"],
      "note": "Wired from volume_preview; POST if GET 404"
    },
    {
      "id": "getTrace",
      "method": "GET",
      "path": "/api/audit/:traceId",
      "status": "wired",
      "pages": ["audit_trace"],
      "note": "Wired from audit_trace; only event_type=receipt shown as persisted"
    },
    {
      "id": "listStepChats",
      "method": "GET",
      "path": "/api/audit/:traceId/chats",
      "status": "wired",
      "pages": ["audit_trace"],
      "note": "Wired from audit_trace read-only; no sending utterances"
