      "note": "Wired from project_home / demo-session hydrate"
    },
    {
      "id": "createTemplate",
      "method": "POST",
      "path": "/api/templates",
      "status": "wired",
      "pages": ["project_home"],
      "note": "Wired from project_home after createSpecPack"
