      "path": "/api/standards/search",
      "status": "wired",
      "pages": ["standard_lib"],
      "note": "Wired from standard_lib"
    },
    {
      "id": "bindEffectiveVersion",
      "method": "POST",
      "path": "/api/packs/:id/effective-version",
      "status": "wired",
