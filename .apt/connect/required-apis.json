      "pages": ["project_home"],
      "note": "Wired from project_home"
    },
    {
      "id": "listSpecPacks",
      "method": "GET",
      "path": "/api/projects/:projectId/packs",
      "status": "wired",
      "pages": ["project_home"],
      "note": "Wired from project_home; response includes templates[]"
    },
    {
      "id": "createSpecPack",
      "method": "POST",
      "path": "/api/packs",
      "status": "wired",
      "pages": ["project_home"],
      "note": "Wired from project_home; default name 空规范包"
    },
    {
      "id": "listTemplates",
      "method": "GET",
      "path": "/api/packs/:id/templates",
      "status": "wired",
