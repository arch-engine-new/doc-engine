  "searches": [
    {
      "query": "第二十四条",
      "count": 1,
      "top": [
        {
          "clause_id": "sver_32ddc7e6b5494e55:第二十四条",
          "heading": "第二十四条 公路建设项目依法实行施工许可制度。国家和国务院交通运输主管部门确定的重点公路建设项目的施工许可由省级人民政府交通运输主管部门实施，其他公路建设项目的施工许可按照项目管理权限由县级以上地方人民政府交通运输主管部门实施。",
          "retrieve_path": "exact",
          "file_name": "t20211228_3633687.html",
          "body": ""
        }
      ]
    },
    {
      "query": "转包或者违法分包",
      "count": 8,
      "top": [
        {
          "clause_id": "sver_32ddc7e6b5494e55:第五十四条",
          "heading": "第五十四条 违反本办法规定，承包单位将承包的工程转包或者违法分包的，责令改正，没收违法所得，对勘察、设计单位处合同约定的勘察费、设计费25%以上50%以下的罚款；对施工单位处工程合同价款5‰以上10‰以下的罚款；可以责令停业整顿，降低资质等级；情节严重的，吊销资质证书。",
          "retrieve_path": "vector",
          "file_name": "t20211228_3633687.html",
          "body": "工程监理单位转让工程监理业务的，责令改正，没收违法所得，处合同约定的监理酬金25%以上50%以下的罚款；可以责令停业整顿，降低资质等级；情节严重的，吊销资质证书"
        },
        {
          "clause_id": "sver_32ddc7e6b5494e55:第三十八条",
          "heading": "第三十八条 施工单位可以将非关键性工程或者适合专业化队伍施工的工程分包给具有相应资格条件的单位，并对分包工程负连带责任。允许分包的工程范围应当在招标文件中规定。分包工程不得再次分包，严禁转包。",
          "retrieve_path": "vector",
          "file_name": "t20211228_3633687.html",
          "body": "任何单位和个人不得违反规定指定分包、指定采购或者分割工程。\n\n项目法人应当加强对施工单位工程分包的管理，所有分包合同须经监理审查，并报项目法人备案。"
        },
        {
          "clause_id": "sver_32ddc7e6b5494e55:第三十七条",
          "heading": "第三十七条 勘察、设计单位经项目法人批准，可以将工程设计中跨专业或者有特殊要求的勘察、设计工作委托给有相应资质条件的单位，但不得转包或者二次分包。",
          "retrieve_path": "vector",
          "file_name": "t20211228_3633687.html",
          "body": "监理工作不得分包或者转包。"
        }
      ]
    },
    {
      "query": "公路建设应当纳入国民经济",
      "count": 8,
      "top": [
        {
          "clause_id": "sver_32ddc7e6b5494e55:第四条",
          "heading": "第四条 国家建立和完善统一、开放、竞争、有序的公路建设市场，禁止任何形式的地区封锁。",
          "retrieve_path": "vector",
          "file_name": "t20211228_3633687.html",
          "body": ""
        },
        {
          "clause_id": "sver_32ddc7e6b5494e55:第三十一条",
          "heading": "第三十一条 公路建设从业单位和从业人员应当严格执行国家有关安全生产的法律、法规、国家标准及行业标准，建立健全安全生产的各项规章制度，明确安全责任，落实安全措施，履行安全管理的职责。",
          "retrieve_path": "vector",
          "file_name": "t20211228_3633687.html",
          "body": ""
        },
        {
          "clause_id": "sver_32ddc7e6b5494e55:第四十三条",
          "heading": "第四十三条 国务院交通运输主管部门和省级地方人民政府交通运输主管部门应当建立公路建设市场的信用管理体系，对进入公路建设市场的从业单位和主要从业人员在招投标活动、签订合同和履行合同中的信用情况进行记录并向社会公布。",
          "retrieve_path": "vector",
          "file_name": "t20211228_3633687.html",
          "body": ""
        }
      ]
    }
  ]
